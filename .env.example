# Address of the RelayOne API
VITE_API_URL=http://localhost:4000

# Optional. Use these when the app and API share a host under a prefix, for example https://example.com/relayone/
#   VITE_API_URL=https://example.com/relayone      (the API has CONTEXT_PATH=/relayone)
#   VITE_BASE_PATH=/relayone/                       (the pages are served from /relayone/)
VITE_BASE_PATH=/
